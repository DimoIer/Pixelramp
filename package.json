{
  "name": "pixelramp",
  "version": "0.1.0",
  "description": "A palette-first pixel texture workbench for Minecraft artists.",
  "author": "PixelRamp",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build --no-bundle",
    "bundle:tauri": "tauri build",
    "package:tauri": "node scripts/package-tauri.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:web": "vite preview --config vite.web.config.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.64.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "studio.pixelramp.app",
    "productName": "PixelRamp",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraFiles": [
      {
        "from": "build/PixelRamp.cmd",
        "to": "PixelRamp.cmd"
      },
      {
        "from": "build/PORTABLE-README.txt",
        "to": "README.txt"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PixelRamp-${version}-win-x64.${ext}"
    }
  }
}
